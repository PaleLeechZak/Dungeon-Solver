// Dungeon generator configuration (JSON5). Anything left out falls back to
// config_default() in src/dungeon/config.odin.
{
	// 0 rolls a fresh seed on every start; any other value is reproducible.
	"seed": 0,

	// Size of the dungeon grid in cells. One cell is one 4x4 Dungeon Pack tile.
	"size": {"width": 56, "height": 56},
	"tile_size": 4.0,

	"generation": {
		"max_rooms": 40,
		"min_rooms": 14,            // retry with a derived seed when fewer rooms fit
		"max_attempts": 8,
		"attempts_per_node": 14,    // templates tried for every open door
		"allow_rotation": true,
		"allow_adjacent_walls": false,
		"depth_bias": 0.35,         // 0 = even growth, 1 = one long winding path
		"entrance_position": [0.5, 0.5]
	},

	// Hallways are generated, not authored: one tile wide, a door at each end
	// and a chance of a side door on every wall cell along the length.
	"hallways": {
		"count": 8,
		"min_length": 2,
		"max_length": 7,
		"side_door_chance": 0.22,
		"weight": 6.0,              // split between all hallways; rooms weigh 1 each by default
		"chain_weight": 0.3,        // multiplier when a hallway hangs off another hallway
		"prune_dead_ends": true,    // drop hallways that ended up leading nowhere
		"floor": "stone"
	},

	// A locked door gets its key placed in an item slot of an earlier room.
	"locks": {"chance": 0.35, "max": 5},

	"assets": {
		// Lists every model, character and animation file in use; everything
		// below names them by the ids given there.
		"manifest": "config/models.json5",
		"texture": "assets/KayKit_Dungeon_Pack_1.1_SOURCE/Assets/textures/dungeon_texture.png"
	},
	// Structural pieces, named after the .gltf files in model_dir.
	"tiles": {
		"wall": ["wall", "wall", "wall", "wall", "wall_cracked", "wall_pillar"],
		"corner": "wall_corner",
		"tsplit": "wall_Tsplit",
		"crossing": "wall_crossing",
		// "file:node" picks one node out of a model, so the door leaf can
		// swing on its hinge independently of the frame around it.
		"doorway": "wall_doorway:wall_doorway",
		"door": "wall_doorway:wall_doorway_door",
		"door_hinge": [-0.82, 0.0, 0.0]
	},

	// Floor sets; a room names one and every cell picks a model from it.
	"floors": {
		"stone": ["floor_tile_large", "floor_tile_large", "floor_tile_large", "floor_tile_large_rocks"],
		"dirt": ["floor_dirt_large", "floor_dirt_large", "floor_dirt_large_rocky"],
		"wood": ["floor_wood_large"]
	},

	// Extra layout characters: a floor cell with one of these props on it.
	"decor": {
		"b": ["barrel_large", "barrel_small_stack", "keg"],
		"c": ["crates_stacked", "box_stacked", "crate_large"],
		"t": ["table_medium", "table_small_decorated_A"],
		"p": ["pillar"],
		"g": ["coin_stack_large", "coin_stack_medium"]
	},

	// Chests hold the items of 'I' slots. The lid is its own node and tips
	// back on its hinge when the knight opens the chest.
	"props": {
		"chest": "chest:chest",
		"chest_lid": "chest:chest_lid",
		"chest_hinge": [0.0, 0.5, -0.565],
		"chest_open_angle": 100.0
	},

	// Items are either shut in a chest or lie on the floor ('i' slots).
	// ground_*: how the item lies on the floor. reveal_y: how high it floats
	// above a closed chest when free flight shows what is inside.
	// Keys are tinted with the colour of the door they open.
	"items": {
		"key": {"model": "key", "scale": 2.5, "tint": [1.0, 1.0, 1.0], "ground_y": 0.25, "ground_tilt": 90.0, "reveal_y": 2.4},
		"sword": {"model": "sword_1handed", "scale": 1.3, "tint": [1.0, 1.0, 1.0], "ground_y": 0.15, "ground_tilt": 90.0, "reveal_y": 2.0},
		"swords": 1,
		// The goal. It is hidden in the deepest room that has an item slot,
		// and picking it up wins the game. Leave the model out for no amulet.
		"amulet": {"model": "amulet", "scale": 2.5, "tint": [1.0, 1.0, 1.0], "ground_y": 0.1, "ground_tilt": 0.0, "reveal_y": 2.2}
	},

	// Only drawn in free flight: where later stages will spawn things.
	"markers": {
		"player_spawn": {"model": "banner_shield_blue", "y": 0.0, "scale": 1.0, "tint": [1.0, 1.0, 1.0]},
		"enemy_spawn": {"model": "sword_shield", "y": 1.2, "scale": 1.0, "tint": [1.0, 0.45, 0.45]},
		"ground_slot": {"model": "floor_tile_small_decorated", "y": 0.04, "scale": 0.5, "tint": [1.0, 1.0, 1.0]}
	},
	// Pre-constructed rooms. Rows read north to south.
	//   #  wall (always on the corners)      .  floor
	//   D  door node                         P  player spawn (entrance only)
	//   ~  wall left off; a run of N joins   E  enemy spawn
	//      a room missing the same N walls   I  item slot: a chest
	//                                        i  item slot: on the floor
	// kind: "normal" (default), "entrance" or "encounter".
	// Props and item slots are solid in knight mode, so a layout is rejected
	// if they stand right inside a door or opening, split the floor in two or
	// wall in an item slot.
	"rooms": [
		{
			"name": "entrance_hall",
			"kind": "entrance",
			"layout": [
				"###D###",
				"#p...p#",
				"#.....#",
				"D..P..D",
				"#.....#",
				"#I...b#",
				"#######"
			]
		},
		{
			"name": "store_room",
			"floor": "wood",
			"layout": [
				"##D##",
				"#b.c#",
				"#...#",
				"#I.c#",
				"#####"
			]
		},
		{
			"name": "crossroads",
			"layout": [
				"##D##",
				"#...#",
				"D.i.D",
				"#...#",
				"##D##"
			]
		},
		{
			"name": "study",
			"floor": "wood",
			"layout": [
				"###D##",
				"#t...#",
				"#....D",
				"#I..b#",
				"######"
			]
		},
		{
			"name": "treasury",
			"max_count": 1,
			"layout": [
				"#####",
				"#IgI#",
				"#g.g#",
				"#...#",
				"##D##"
			]
		},
		{
			"name": "guard_room",
			"kind": "encounter",
			"layout": [
				"###D###",
				"#.....#",
				"D.E.E.D",
				"#.....#",
				"#c.I..#",
				"#######"
			]
		},
		{
			"name": "barracks",
			"kind": "encounter",
			"weight": 0.8,
			"layout": [
				"####D###",
				"#b....c#",
				"#.E..E.#",
				"D......#",
				"#.E..E.#",
				"#.I....#",
				"###D####"
			]
		},
		{
			"name": "pit",
			"kind": "encounter",
			"floor": "dirt",
			"layout": [
				"##D##",
				"#E.E#",
				"#...#",
				"#.i.#",
				"#####"
			]
		},

		// Rooms with walls left off. Two rooms missing the same number of walls
		// slot together and read as a single L-, T- or plus-shaped room.
		{
			"name": "great_hall",
			"kind": "encounter",
			"weight": 1.5,
			"layout": [
				"###D###",
				"#p....~",
				"#..E..~",
				"#p....~",
				"#.....#",
				"###D###"
			]
		},
		{
			"name": "hall_wing",
			"weight": 1.5,
			"layout": [
				"#####",
				"~..I#",
				"~...D",
				"~..b#",
				"#####"
			]
		},
		{
			"name": "cellar",
			"kind": "encounter",
			"floor": "dirt",
			"layout": [
				"##~~##",
				"#....#",
				"D.E..#",
				"#b..I#",
				"######"
			]
		},
		{
			"name": "cellar_nook",
			"floor": "dirt",
			"layout": [
				"#~~#",
				"#..#",
				"#Ic#",
				"####"
			]
		},
		{
			"name": "gallery",
			"layout": [
				"###D###",
				"#.....#",
				"~.....~",
				"#.....#",
				"###D###"
			]
		},
		{
			"name": "alcove",
			"layout": [
				"####",
				"~.i#",
				"####"
			]
		}
	],

	// Knight mode: WASD walks relative to the camera, hold right mouse to
	// orbit, mouse wheel zooms. Reaching a chest opens it and hands over what
	// is inside; items on the floor are picked up. Doors open as the knight
	// reaches them, locked ones only once their key is held. With the sword in
	// hand, left click or Space swings it.
	// Tab switches to free flight, which also shows what the chests hold and
	// where the spawn points are.
	"play": {
		"start": true,
		"speed": 9.0,
		"radius": 0.5,
		"interact_radius": 2.2,
		"turn_speed": 12.0,
		"camera_distance": 16.0,
		"camera_pitch": -50.0,
		"character": "knight",
		"idle": {
			"file": "general",
			"clip": "Idle_A"
		},
		"move": {
			"file": "movement",
			"clip": "Running_A"
		},
		"swing": {
			"file": "melee",
			"clip": "Melee_1H_Attack_Slice_Diagonal"
		},
		"hurt": {
			"file": "general",
			"clip": "Hit_A"
		},
		"death": {
			"file": "general",
			"clip": "Death_A"
		},
		// Finding the amulet: the knight holds it up and cheers for this long
		// before the victory screen. Nothing can hurt it meanwhile.
		"celebrate": {"file": "simulation", "clip": "Cheering"},
		"celebrate_time": 3.3,
		// As the celebration starts the camera pans from the knight to the
		// amulet, taking this long, and holds there until the victory screen.
		"celebrate_pan": 1.0,
		"celebrate_distance": 7.0,   // how close it comes
		"celebrate_pitch": -14.0,    // degrees; shallower than the usual view
		"sword_joint": "handslot.r",
		"health": 5,               // pips shown in the upper left corner
		"sword_reach": 3.2,        // world units from the knight's centre
		"sword_arc": 75.0,         // degrees either side of straight ahead
		"sword_damage": 1,
		"sword_hit_time": 0.4,     // fraction of the swing at which the blade connects
		"invulnerable": 0.9,       // seconds of grace after being hurt
		"hit_flash": 0.18          // seconds the knight or a skeleton flashes white when hit
	},

	// Skeletons rise at every enemy spawn point ('E' in a layout). They notice
	// the knight within `sight` units of walking distance, run at it and
	// strike. Shut doors stop them. They stand still in free flight.
	"enemies": {
		"enabled": true,
		"character": "skeleton_warrior",
		"weapon": "Skeleton_Blade",
		"weapon_joint": "handslot.r",
		"health": 2,
		"speed": 5.5,
		"radius": 0.5,
		"sight": 28.0,
		"attack_range": 2.2,
		"attack_windup": 0.45,     // seconds between starting a blow and it landing
		"attack_recovery": 0.9,
		"damage": 1,
		"stagger": 0.5             // seconds a skeleton reels after being hit
	},

	// Sound effects. The manifest lists every sound file the game uses and
	// which in-game action plays which of them. Volumes are set in the pause
	// menu's options and saved with the other settings.
	"sounds": {
		"enabled": true,
		"manifest": "config/sounds.json5",
		"hearing": 45.0,           // world units at which a sound has faded to nothing
		"voices": 16,              // sounds that can play at once
		"knight_stride": 2.6,      // world units between footfalls
		"skeleton_stride": 2.4
	},

	// Heads-up display. Control prompts use the Kenney input font that matches
	// the device last touched; each font's *_characters.txt names its icons.
	"ui": {
		"font": "assets/fonts/Crimson_Pro/static/CrimsonPro-Medium.ttf",
		"font_size": 26.0,
		"icon_size": 40.0,
		"atlas_size": 1024,
		// Where the pause menu saves volumes and rebound controls.
		"settings": "settings.json",
		// Open on the main menu. false drops straight into the dungeon, which
		// is handy while working on it.
		"main_menu": true,
		// Menus are built from the Kenney fantasy UI kit: white pieces that are
		// tinted when drawn. Panels and borders stretch as nine-slices keeping
		// `margin` pixels of frame; the divider keeps `divider_cap` pixels of
		// ornament at its end.
		"kit": {
			"dir": "assets/kenney_fantasy-ui-borders/PNG/Double",
			"window": "Panel/panel-010.png",
			"window_border": "Border/panel-border-010.png",
			"button": "Panel/panel-009.png",
			"button_border": "Border/panel-border-009.png",
			"track": "Panel/panel-015.png",
			"divider": "Divider/divider-003.png",
			"margin": 32.0,
			"divider_cap": 56.0
		},
		"prompts": {
			"keyboard_mouse": {
				"font": "assets/kenney_input-prompts_1.5/Keyboard & Mouse/Fonts/kenney_input_keyboard_&_mouse.ttf",
				"characters": "assets/kenney_input-prompts_1.5/Keyboard & Mouse/Fonts/kenney_input_keyboard_&_mouse_characters.txt"
			},
			"xbox": {
				"font": "assets/kenney_input-prompts_1.5/Xbox Series/Fonts/kenney_input_xbox_series.ttf",
				"characters": "assets/kenney_input-prompts_1.5/Xbox Series/Fonts/kenney_input_xbox_series_characters.txt"
			},
			"playstation": {
				"font": "assets/kenney_input-prompts_1.5/PlayStation Series/Fonts/kenney_input_playstation_series.ttf",
				"characters": "assets/kenney_input-prompts_1.5/PlayStation Series/Fonts/kenney_input_playstation_series_characters.txt"
			},
			"switch": {
				"font": "assets/kenney_input-prompts_1.5/Nintendo Switch/Fonts/kenney_input_nintendo_switch.ttf",
				"characters": "assets/kenney_input-prompts_1.5/Nintendo Switch/Fonts/kenney_input_nintendo_switch_characters.txt"
			}
		}
	},

	// Free camera: WASD to move, Q/E down/up, hold right mouse to look,
	// Shift to move fast, mouse wheel to change speed.
	"camera": {"speed": 18.0, "fast_multiplier": 4.0, "sensitivity": 0.003, "fov": 60.0},

	"window": {"width": 1600, "height": 900, "title": "Dungeon Solver"}
}
