// Model manifest (JSON5).
//
// The complete list of model files the game uses, out of the thousands under
// assets/. The config refers to everything here by id; nothing else is
// loaded, and the packaging script ships exactly these files (plus the
// buffers and textures each .gltf names). Paths are relative to "root".
//
//   models      static tiles, props, items and weapons (.gltf)
//   characters  skinned characters with their texture embedded (.glb)
//   animations  files of animation clips for those characters (.glb)
//
// An id the config uses but this file lacks is an error, and so is an entry
// here that the config does not use: remove what is no longer needed.
{
	"root": "assets",

	"models": {
		"amulet": "amulet.gltf",
		"banner_shield_blue": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/banner_shield_blue.gltf",
		"barrel_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/barrel_large.gltf",
		"barrel_small_stack": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/barrel_small_stack.gltf",
		"box_stacked": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/box_stacked.gltf",
		"chest": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/chest.gltf",
		"coin_stack_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/coin_stack_large.gltf",
		"coin_stack_medium": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/coin_stack_medium.gltf",
		"crate_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/crate_large.gltf",
		"crates_stacked": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/crates_stacked.gltf",
		"floor_dirt_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/floor_dirt_large.gltf",
		"floor_dirt_large_rocky": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/floor_dirt_large_rocky.gltf",
		"floor_tile_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/floor_tile_large.gltf",
