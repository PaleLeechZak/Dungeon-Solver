		"floor_wood_large": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/floor_wood_large.gltf",
		"keg": "KayKit_Dungeon_Pack_1.1_SOURCE/Assets/gltf/keg.gltf",
